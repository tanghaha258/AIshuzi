{
  "name": "ai-digital-student-micro-teaching-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/server/index.js",
    "test:agent-dialogue": "tsx scripts/agent-dialogue-contract.ts",
    "test:agent-runtime": "tsx scripts/agent-runtime-contract.ts",
    "test:ui": "node scripts/ui-contract.mjs",
    "test:lesson-planner": "tsx scripts/lesson-planner-contract.ts",
    "test:transcript": "tsx scripts/transcript-contract.ts",
    "test:observation": "tsx scripts/observation-contract.ts",
    "test:teacher-vision": "tsx scripts/teacher-vision-contract.ts",
    "test:teacher-vision-hook": "node scripts/teacher-vision-hook-contract.mjs",
    "test:camera-hook": "node scripts/camera-hook-contract.mjs",
    "test:training-input": "tsx scripts/training-input-contract.ts",
    "test:report-generator": "tsx scripts/report-generator-contract.ts",
    "test:ai-observability": "tsx scripts/ai-observability-contract.ts",
    "test:provider": "tsx scripts/provider-contract.ts",
    "test:data-lifecycle": "tsx scripts/data-lifecycle-contract.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run build && npm run test:agent-runtime && npm run test:agent-dialogue && npm run test:lesson-planner && npm run test:transcript && npm run test:observation && npm run test:teacher-vision && npm run test:teacher-vision-hook && npm run test:camera-hook && npm run test:training-input && npm run test:report-generator && npm run test:ui && npm run test:provider && npm run test:ai-observability && npm run test:data-lifecycle && npm run smoke",
    "electron": "echo Electron shell is scaffolded in ./electron and can be wired after web validation.",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cors": "^2.8.5",
    "express": "5.2.1",
    "lucide-react": "0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.1",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vite": "8.0.14"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3"
  }
}
